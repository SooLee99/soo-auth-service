# Soo Auth Service Environment Example

SPRING_PROFILES_ACTIVE=local

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=soo_auth
DB_USERNAME=local_user
DB_PASSWORD=change_me_locally

# Triplan External APIs
TOUR_API_BASE_URL=https://apis.data.go.kr
TOUR_API_KEY=replace_with_local_secret

KAKAO_LOCAL_BASE_URL=https://dapi.kakao.com
KAKAO_REST_API_KEY=replace_with_local_secret

# JWT
JWT_ISSUER=soo-auth-local
JWT_SECRET=replace_with_local_secret

# Do not commit real values.
