### 공통 변수
@baseUrl = http://localhost:8080
@deviceId = dev-123
@serviceCode = SHOP

### 서비스 휴대폰 인증번호 발급
# @name service_phone_verification_request
POST {{baseUrl}}/api/v1/services/{{serviceCode}}/auth/local/phone-verifications/request
Content-Type: application/json
Accept: application/json

{
  "phoneNumber": "+82 10-8779-6627"
}

> {%
    const verificationId = response.body?.data?.verificationId;
    if (!verificationId) {
        throw new Error("verificationId 파싱 실패: " + JSON.stringify(response.body));
    }
    client.global.set("serviceVerificationId", verificationId);
%}

### 서비스 휴대폰 인증번호 확인
# @name service_phone_verification_confirm
POST {{baseUrl}}/api/v1/services/{{serviceCode}}/auth/local/phone-verifications/confirm
Content-Type: application/json
Accept: application/json

{
  "phoneNumber": "+82 10-1234-5678",
  "verificationId": "{{serviceVerificationId}}",
  "code": "123456"
}

> {%
    const token = response.body?.data?.phoneVerificationToken;
    if (!token) {
        throw new Error("phoneVerificationToken 파싱 실패: " + JSON.stringify(response.body));
    }
    client.global.set("servicePhoneVerificationToken", token);
%}

### 서비스 회원가입
# @name service_signup
POST {{baseUrl}}/api/v1/services/{{serviceCode}}/auth/local/signup
X-Device-Id: {{deviceId}}
Content-Type: application/json
Accept: application/json

{
  "email": "service-user@example.com",
  "password": "P@ssw0rd!",
  "name": "홍길동",
  "nickname": "service_user",
  "gender": "MALE",
  "phoneNumber": "+82 10-1234-5678",
  "phoneVerificationToken": "{{servicePhoneVerificationToken}}",
  "locale": "ko-KR",
  "profileImageUrl": "https://example.com/profile.png",
  "thumbnailImageUrl": "https://example.com/thumb.png",
  "birthyear": "1998",
  "birthday": "02-07"
}

### 서비스 전화번호 회원가입
# @name service_signup_phone
POST {{baseUrl}}/api/v1/services/{{serviceCode}}/auth/local/signup/phone
X-Device-Id: {{deviceId}}
Content-Type: application/json
Accept: application/json

{
  "phoneNumber": "+82 10-1234-5678",
  "phoneVerificationToken": "{{servicePhoneVerificationToken}}"
}

### 서비스 로컬 로그인
# @name service_local_login
POST {{baseUrl}}/api/v1/services/{{serviceCode}}/auth/local/login
X-Device-Id: {{deviceId}}
Content-Type: application/json
Accept: application/json

{
  "email": "service-user@example.com",
  "password": "P@ssw0rd!"
}

> {%
    const payload = response.body?.data?.tokens;
    if (!payload?.accessToken || !payload?.refreshToken) {
        throw new Error("토큰 파싱 실패: " + JSON.stringify(response.body));
    }
    client.global.set("serviceAccessToken", payload.accessToken);
    client.global.set("serviceRefreshToken", payload.refreshToken);
%}

### 서비스 토큰 갱신
# @name service_refresh
POST {{baseUrl}}/api/v1/services/{{serviceCode}}/auth/local/token/refresh
X-Device-Id: {{deviceId}}
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{serviceRefreshToken}}"
}

> {%
    const payload = response.body?.data?.tokens;
    if (!payload?.accessToken || !payload?.refreshToken) {
        throw new Error("토큰 파싱 실패: " + JSON.stringify(response.body));
    }
    client.global.set("serviceAccessToken", payload.accessToken);
    client.global.set("serviceRefreshToken", payload.refreshToken);
%}

### 서비스 로그아웃
# @name service_logout
POST {{baseUrl}}/api/v1/services/{{serviceCode}}/auth/local/logout
X-Device-Id: {{deviceId}}
Authorization: Bearer {{serviceAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{serviceRefreshToken}}",
  "logoutAll": false
}

### 서비스 회원 탈퇴
# @name service_withdraw
POST {{baseUrl}}/api/v1/services/{{serviceCode}}/auth/local/withdraw
Authorization: Bearer {{serviceAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "reason": "privacy"
}

### 서비스 OAuth2 인가 URL 조회
# @name service_oauth2_authorize_url
GET {{baseUrl}}/api/v1/services/{{serviceCode}}/auth/oauth2/kakao/authorize-url?returnUrl=/app/callback
X-Device-Id: {{deviceId}}
Accept: application/json
