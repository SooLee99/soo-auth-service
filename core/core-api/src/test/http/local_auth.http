### 공통 변수
@baseUrl = http://localhost:8080
@deviceId = dev-123
@logoutAll = false

### 회원가입
# @name signup
POST {{baseUrl}}/api/v1/auth/local/signup
X-Device-Id: {{deviceId}}
Content-Type: application/json
Accept: application/json

{
  "email": "a1@a.com",
  "password": "password123@",
  "phoneNumber": "010-1234-5678",
  "gender": "MALE",
  "locale": "ko-KR",
  "nickname": "soo_01",
  "name": "홍길동",
  "profileImageUrl": "https://example.com/profile.png",
  "thumbnailImageUrl": "https://example.com/thumb.png",
  "birthyear": "1998",
  "birthday": "02-07"
}

### 로그인 (토큰 변수 저장)
# @name login
POST {{baseUrl}}/api/v1/auth/local/login
X-Device-Id: {{deviceId}}
Content-Type: application/json
Accept: application/json

{
  "email": "a1@a.com",
  "password": "password123@"
}

> {%

    const payload = response.body.data;

    if (!payload?.accessToken || !payload?.refreshToken) {
        throw new Error("토큰 파싱 실패: 응답 구조를 확인하세요. body=" + JSON.stringify(response.body));
    }

    client.global.set("accessToken", payload.accessToken);
    client.global.set("refreshToken", payload.refreshToken);
    client.global.set("deviceId", request.headers["X-Device-Id"] || "{{deviceId}}");
%}

### refresh (회전: 새 access + 새 refresh 발급) + 변수 업데이트
# @name refresh
POST {{baseUrl}}/api/v1/auth/local/token/refresh
X-Device-Id: {{deviceId}}
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
    const payload = response.body?.data?.data ?? response.body?.data;

    if (!payload?.accessToken || !payload?.refreshToken) {
        throw new Error("토큰 파싱 실패: 응답 구조를 확인하세요. body=" + JSON.stringify(response.body));
    }

    client.global.set("accessToken", payload.accessToken);
    client.global.set("refreshToken", payload.refreshToken);
%}

### logout (현재 access denylist + refresh revoke)
# @name logout
POST {{baseUrl}}/api/v1/auth/local/logout
X-Device-Id: {{deviceId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}",
  "logoutAll": false
}

### (옵션) logoutAll = true 테스트용
# @name logout_all
POST {{baseUrl}}/api/v1/auth/local/logout
X-Device-Id: {{deviceId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}",
  "logoutAll": true
}