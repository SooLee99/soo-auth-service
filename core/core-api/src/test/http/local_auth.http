### 회원가입
POST http://localhost:8080/api/v1/auth/signup
X-Device-Id: dev-123
Content-Type: application/json
Accept: application/json

{
  "email": "a1@a.com",
  "password": "password123@",
  "phoneNumber": "010-1234-5678",
  "gender": "MALE",
  "locale": "ko-KR",
  "nickname": "soo_01",
  "name": "홍길동",
  "profileImageUrl": "https://example.com/profile.png",
  "thumbnailImageUrl": "https://example.com/thumb.png",
  "birthyear": "1998",
  "birthday": "02-07"
}

### 로그인 (토큰 변수 저장)
# @name login
POST http://localhost:8080/api/v1/auth/login
X-Device-Id: dev-123
Content-Type: application/json
Accept: application/json

{
  "email": "a1@a.com",
  "password": "password123@"
}

> {%
    // 로그인 응답 예시:
    // { "result": "OK", "data": { "accessToken": "...", "refreshToken": "...", ... } }
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}

### refresh (회전: 새 access + 새 refresh 발급) + 변수 업데이트
# @name refresh
POST http://localhost:8080/api/v1/auth/token/refresh
X-Device-Id: dev-123
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "73bbe0d2afb94760bf3e5fb80067805fe1655288c1e24d42955ee7b82eeb47ac"
}

> {%
    client.global.set("accessToken", response.body.data.accessToken);
    client.global.set("refreshToken", response.body.data.refreshToken);
%}


