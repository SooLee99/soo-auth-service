### 공통 변수
@baseUrl = http://localhost:8080
@adminAccessToken = replace-with-admin-token
@targetUserId = 1
@serviceCode = SHOP
@smsTo = 01012345678

### 관리자 헬스 체크
# @name admin_health
GET {{baseUrl}}/api/v1/auth/admin/health
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 로그인 이력 조회
# @name admin_login_history
GET {{baseUrl}}/api/v1/auth/admin/login-history?page=0&size=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 사용자 목록 조회
# @name admin_users_list
GET {{baseUrl}}/api/v1/auth/admin/users?page=0&size=20&keyword=user&userStatus=ACTIVE&role=USER&authProvider=LOCAL
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 사용자 상세 조회
# @name admin_user_detail
GET {{baseUrl}}/api/v1/auth/admin/users/{{targetUserId}}
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 사용자 정보 수정
# @name admin_user_update
PATCH {{baseUrl}}/api/v1/auth/admin/users/{{targetUserId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "nickname": "updated_nickname",
  "role": "ADMIN",
  "blocked": false,
  "emailVerified": true,
  "phoneVerified": true
}

### 사용자 차단
# @name admin_user_block
POST {{baseUrl}}/api/v1/auth/admin/users/{{targetUserId}}/block
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "reason": "abuse"
}

### 사용자 차단 해제
# @name admin_user_unblock
POST {{baseUrl}}/api/v1/auth/admin/users/{{targetUserId}}/unblock
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 사용자 비밀번호 재설정
# @name admin_user_password_reset
POST {{baseUrl}}/api/v1/auth/admin/users/{{targetUserId}}/password/reset
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "newPassword": "NewP@ssw0rd!"
}

### 사용자 토큰 강제 만료
# @name admin_user_tokens_revoke
POST {{baseUrl}}/api/v1/auth/admin/users/{{targetUserId}}/tokens/revoke
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 사용자 상태 변경 이력 조회
# @name admin_user_status_audits
GET {{baseUrl}}/api/v1/auth/admin/users/{{targetUserId}}/status-audits?page=0&size=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 차단 사용자 목록 조회
# @name admin_blocked_users
GET {{baseUrl}}/api/v1/auth/admin/users/blocked?page=0&size=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 탈퇴 사용자 목록 조회
# @name admin_deleted_users
GET {{baseUrl}}/api/v1/auth/admin/users/deleted?page=0&size=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 사용자 삭제(소프트 삭제)
# @name admin_user_delete
POST {{baseUrl}}/api/v1/auth/admin/users/{{targetUserId}}/delete
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "reason": "admin-delete"
}

### 서비스 등록
# @name admin_service_register
POST {{baseUrl}}/api/v1/auth/admin/services
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "serviceCode": "CRM",
  "serviceName": "CRM Service"
}

### 서비스 목록 조회
# @name admin_service_list
GET {{baseUrl}}/api/v1/auth/admin/services?page=0&size=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 서비스 비활성화
# @name admin_service_deactivate
POST {{baseUrl}}/api/v1/auth/admin/services/{{serviceCode}}/deactivate
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 관리자 문자 발송
# @name admin_sms_send
POST {{baseUrl}}/api/v1/auth/admin/sms/send
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "to": "{{smsTo}}",
  "text": "[ADMIN] 시스템 점검 안내 테스트 문자입니다."
}

### 관리자 문자 발송 이력 조회
# @name admin_sms_logs
GET {{baseUrl}}/api/v1/auth/admin/sms/logs?page=0&size=20
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 관리자 문자 발송 이력 조회 (기간 필터)
# @name admin_sms_logs_by_range
GET {{baseUrl}}/api/v1/auth/admin/sms/logs?page=0&size=20&startDate=2026-03-01T00:00:00&endDate=2026-03-31T23:59:59
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 관리자 문자 발송 통계 조회
# @name admin_sms_stats
GET {{baseUrl}}/api/v1/auth/admin/sms/stats
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### 관리자 문자 발송 통계 조회 (기간 필터)
# @name admin_sms_stats_by_range
GET {{baseUrl}}/api/v1/auth/admin/sms/stats?startDate=2026-03-01T00:00:00&endDate=2026-03-31T23:59:59
Authorization: Bearer {{adminAccessToken}}
Accept: application/json
