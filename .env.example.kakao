# soo-auth-service - Kakao 로그인 / JWT 관련 env vars (triplan MVP 추가)
# 기존 .env / application-*.yml에 병합하세요. 실값은 .env.local 또는 비밀 저장소로 분리.

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 자체 JWT (travel-service와 동일 시크릿 공유)
JWT_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS — 프론트엔드 dev origin
CORS_ORIGINS=http://localhost:5173
